{
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Search by task"
      },
      "description": "Default tool: find AI apps, MCP servers, skills and agents for a concrete task described in the user's own words. Returns up to 10 items from AI 뭐 쓰지? (arete.ai.kr), best match first. Korean or English queries; pass Korean as-is, don't translate. MCP servers and skills need developer tools; for non-developers pass kind=app. Each item's match is strong or weak; if all are weak, say nothing fits exactly. Items sharing a name are folded (same_name). When the user picks one: read detail_md_url for setup, then first_try, then needs; never invent a missing step. Credit 'AI 뭐 쓰지? (arete.ai.kr)' and link each item's url.",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "The task in the user's words, 1-100 chars.",
            "maxLength": 100,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "enum": [
                  "app",
                  "mcp",
                  "skill",
                  "agent"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "app, mcp, skill or agent; omit for all four.",
            "title": "Kind"
          },
          "ko": {
            "default": false,
            "description": "true = Korean-supported items only (default false).",
            "title": "Ko",
            "type": "boolean"
          },
          "limit": {
            "default": 10,
            "description": "Number of results, 1-10 (default 10).",
            "maximum": 10,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "lang": {
            "default": "ko",
            "description": "en = English names and field labels where available; summaries stay Korean (default ko).",
            "enum": [
              "ko",
              "en"
            ],
            "title": "Lang",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "title": "searchArguments"
      },
      "name": "search",
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "searchDictOutput"
      },
      "title": "Search by task"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Browse a field"
      },
      "description": "Browse one known field (a key or name from list_fields, e.g. video.short_form); not for free text — for a task in the user's words use search. Ranked by popularity, with ko (Korean-supported) and free (apps with a confirmed free plan, kind=app only) filters. Credit 'AI 뭐 쓰지? (arete.ai.kr)' and link each item's url.",
      "inputSchema": {
        "properties": {
          "field": {
            "description": "Field key or name from list_fields; an unknown value returns the top-level fields.",
            "maxLength": 40,
            "minLength": 1,
            "title": "Field",
            "type": "string"
          },
          "kind": {
            "default": "app",
            "description": "app (default), mcp, skill or agent.",
            "enum": [
              "app",
              "mcp",
              "skill",
              "agent"
            ],
            "title": "Kind",
            "type": "string"
          },
          "ko": {
            "default": false,
            "description": "true = Korean-supported items only (default false).",
            "title": "Ko",
            "type": "boolean"
          },
          "free": {
            "default": false,
            "description": "true = apps with a confirmed free plan only, kind=app only (default false).",
            "title": "Free",
            "type": "boolean"
          },
          "limit": {
            "default": 10,
            "description": "Number of results, 1-10 (default 10).",
            "maximum": 10,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "lang": {
            "default": "ko",
            "description": "en = English names and field labels where available; summaries stay Korean (default ko).",
            "enum": [
              "ko",
              "en"
            ],
            "title": "Lang",
            "type": "string"
          }
        },
        "required": [
          "field"
        ],
        "type": "object",
        "title": "find_by_fieldArguments"
      },
      "name": "find_by_field",
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "find_by_fieldDictOutput"
      },
      "title": "Browse a field"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Popularity ranking"
      },
      "description": "Popularity ranking per kind, optionally within a field. period=day|week|month ranks by the largest gain in that window, so big items lead; for small items rising fast use get_trending. Rank positions only, no raw metrics. Credit 'AI 뭐 쓰지? (arete.ai.kr)' and link each item's url.",
      "inputSchema": {
        "properties": {
          "kind": {
            "description": "app, mcp, skill or agent.",
            "enum": [
              "app",
              "mcp",
              "skill",
              "agent"
            ],
            "title": "Kind",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional field key or name from list_fields to narrow the list.",
            "title": "Field"
          },
          "period": {
            "default": "all",
            "description": "all (default), day, week or month.",
            "enum": [
              "all",
              "day",
              "week",
              "month"
            ],
            "title": "Period",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "description": "Number of results, 1-20 (default 10).",
            "maximum": 20,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object",
        "title": "get_rankingArguments"
      },
      "name": "get_ranking",
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "get_rankingDictOutput"
      },
      "title": "Popularity ranking"
    },
