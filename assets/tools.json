              "week",
              "month"
            ],
            "title": "Period",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "description": "Number of results, 1-10 (default 10).",
            "maximum": 10,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object",
        "title": "get_trendingArguments"
      },
      "name": "get_trending",
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "get_trendingDictOutput"
      },
      "title": "Trending"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
        "title": "Item details"
      },
      "description": "One item by item_id from another tool's results. Adds platforms, get_on (kinds of download places; links are in detail_md_url) and, for apps, alternatives. When the user picks one: read detail_md_url for setup, then first_try, then needs; never invent a missing step. Credit 'AI 뭐 쓰지? (arete.ai.kr)' and link each item's url.",
      "inputSchema": {
